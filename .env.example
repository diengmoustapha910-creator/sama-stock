# APP_URL: URL publique de l'application (en production : https://sama-stock.com)
APP_URL="https://sama-stock.com"

# PORT: Injecté automatiquement par Google Cloud Run (par défaut 8080 en conteneur, 3000 en dev)
PORT="8080"
NODE_ENV="production"

# UNITECHPAY WEBHOOK & WAVE CONFIGURATION (Uniquement UnitechPay)
UNITECHPAY_API_URL="https://api.unitech.sn/api.php"
# UNITECHPAY_API_KEY doit être injectée via Google Secret Manager en production (--set-secrets)
UNITECHPAY_API_KEY=""
# URL HTTPS officielle du webhook UnitechPay après bascule DNS/SSL sur sama-stock.com
UNITECHPAY_WEBHOOK_URL="https://sama-stock.com/api/webhooks/unitechpay"

# GOOGLE CLOUD SQL POSTGRESQL (À activer uniquement après validation de la migration BDD)
# DATABASE_URL="postgresql://samastock_app:<SECRET>@/sama_stock?host=/cloudsql/<PROJECT_ID>:europe-west1:<INSTANCE_NAME>"
# DB_HOST="/cloudsql/<PROJECT_ID>:europe-west1:<INSTANCE_NAME>"
# DB_NAME="sama_stock"
# DB_USER="samastock_app"
# DB_PASSWORD=""

# FUSEAU HORAIRE SÉNÉGAL & SÉCURITÉ SESSIONS
TZ="Africa/Dakar"
# CSRF_SECRET="<CLE_ALEATOIRE_32_OCTETS_VIA_SECRET_MANAGER>"
# REDIS_URL="redis://:<PASSWORD>@<MEMORYSTORE_PRIVATE_IP>:6379"

# MOT DE PASSE INITIAL ADMINISTRATEUR PRINCIPAL SAMA STOCK (à injecter via Secret Manager si nouvel environnement)
# SAMA_ADMIN_INITIAL_PASSWORD="<A_DEFINIR_PAR_SECRET_FORT>"
# UNITECHPAY_WEBHOOK_MAX_AGE_SECONDS="86400"
# ENABLE_UNITECHPAY_SANDBOX="false"

# SERVICE D'E-MAILS TRANSACTIONNELS (Réinitialisation de mot de passe - support@sama-stock.com)
# EMAIL_FROM="SAMA STOCK <support@sama-stock.com>"
# EMAIL_REPLY_TO="support@sama-stock.com"
# Option A (Recommandée - HTTPS port 443) - Brevo API v3
# BREVO_API_KEY=""
# Option B (HTTPS port 443) - Resend API
# RESEND_API_KEY=""
# Option C - SMTP standard (Brevo SMTP, Google Workspace / Gmail, OVH, Mailgun, Postmark...)
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""


